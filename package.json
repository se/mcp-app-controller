{
  "name": "mcp-app-controller",
  "version": "0.1.0",
  "description": "Central app-control daemon with MCP interface for multi-session Claude coordination",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && npm --prefix ui run build",
    "build:ui": "npm --prefix ui run build",
    "restart": "scripts/restart-daemon.sh",
    "deploy": "npm run build && scripts/restart-daemon.sh",
    "dev:ui": "npm --prefix ui run dev",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  }
}
